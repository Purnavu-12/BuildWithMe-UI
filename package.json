{
  "name": "buildwithme-ui",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm registry:build && pnpm previews:build && next dev --hostname 127.0.0.1",
    "build": "pnpm registry:build && pnpm previews:build && next build",
    "start": "next start --hostname 127.0.0.1",
    "lint": "eslint .",
    "typecheck": "pnpm registry:build && next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:install": "tsx scripts/install-smoke.ts",
    "registry:validate": "tsx scripts/registry.ts validate",
    "registry:build": "tsx scripts/registry.ts build",
    "previews:build": "tsx scripts/build-preview-runtimes.ts",
    "packages:build": "tsx scripts/build-packages.ts",
    "packages:pack": "pnpm packages:build && tsx scripts/pack-smoke.ts",
    "env:validate": "node scripts/validate-production-env.mjs",
    "component:new": "tsx scripts/new-component.ts",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm registry:validate && pnpm build && pnpm packages:pack",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@react-three/fiber": "9.8.1",
    "animejs": "4.5.0",
    "geist": "1.4.2",
    "lucide-react": "0.468.0",
    "motion": "13.4.4",
    "next": "16.3.6",
    "next-themes": "0.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "three": "0.186.1",
    "vue": "3.5.43",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.11.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@sveltejs/package": "2.5.8",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.19.1",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@types/three": "0.186.0",
    "@vitejs/plugin-vue": "6.0.9",
    "eslint": "10.11.0",
    "prettier": "3.9.9",
    "prettier-plugin-svelte": "4.1.1",
    "svelte": "5.57.1",
    "tailwindcss": "4.3.3",
    "tsup": "8.5.1",
    "tsx": "4.21.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.1",
    "vite": "8.3.1",
    "vitest": "4.1.11",
    "vue-tsc": "^3.3.11"
  }
}
